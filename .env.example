# =============================================================================
# FEFO Allocator — environment configuration
# Copy to .env.local (git-ignored) and fill in real values.
# NEVER commit service-role keys, secret keys or database passwords.
# =============================================================================

# --- Supabase project (Project Settings → API) -------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co

# Browser-safe publishable key. Injected into the web bundle at BUILD time by
# scripts/build-web.mjs — this is the ONLY key the frontend ever sees.
# (Legacy name VITE_SUPABASE_ANON_KEY is also accepted.)
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Server-side secret key. Used by the CLI (import/allocate --db) and any
# Node.js code. NEVER prefix it with VITE_ and never ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Feature flag -------------------------------------------------------------
# false (default): the allocator reads stock from the WMS workbook, as before.
# true  (or CLI flag --db): the allocator reads stock from the database.
DATABASE_MODE=false

# --- Integration tests --------------------------------------------------------
# Plain PostgreSQL 16 server for tests/db-integration.test.ts and
# tests/parity.test.ts. The tests create/drop a throwaway database on it, so
# do NOT point this at a database you care about. When unset, the suites skip
# loudly. Local example:
#   docker run -d --name fefo-test -e POSTGRES_PASSWORD=test -p 54329:5432 postgres:16
TEST_DATABASE_URL=postgres://postgres:test@localhost:54329/postgres
